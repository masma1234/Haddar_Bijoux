{
  "name": "haddar-bijoux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "preview": "node scripts/serve.mjs",
    "check": "astro check",
    "audit:prerender": "node scripts/check-prerender.mjs",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "audit:browser": "node scripts/audit-browser.mjs",
    "audit:contrast": "node scripts/check-contrast.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "audit:budgets": "node scripts/check-budgets.mjs",
    "test:guards": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-build-guards.mjs",
    "test:routing": "node scripts/test-routing.mjs",
    "test:visual": "node scripts/visual-regression.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/italiana": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "playwright": "1.64.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
