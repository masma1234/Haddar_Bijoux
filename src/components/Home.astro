---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { dictionary, homePath, type Locale } from '../i18n';
import { business, draft } from '../data/business';
import { images, type EditorialImage } from '../data/images';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dictionary(locale);
const instagram = draft.instagram;
const imagePath = (asset: EditorialImage, format = 'jpg', width?: number) =>
  `/incoming/${asset.id}${width ? `-${width}` : ''}.${format}`;
const collection = [
  { image: images.bracelets, title: t.collectionItems[0].title, descriptor: t.collectionItems[0].descriptor },
  { image: images.personalized, title: t.collectionItems[1].title, descriptor: t.collectionItems[1].descriptor },
  { image: images.earrings, title: t.collectionItems[2].title, descriptor: t.collectionItems[2].descriptor },
  { image: images.necklaces, title: t.collectionItems[3].title, descriptor: t.collectionItems[3].descriptor },
];
const responsiveSources = (asset: EditorialImage, format: 'avif' | 'webp') =>
  [480, 800, 1200].map(width => `${imagePath(asset, format, width)} ${width}w`).join(', ');
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Haddar Bijoux',
  url: new URL(homePath(locale), Astro.site).href,
  sameAs: [instagram],
}];
---
<Base locale={locale} title={t.title} description={t.description} home schema={schema}>
  <main id="main" tabindex="-1">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 id="hero-title">{t.heroTitle}</h1>
        <p class="hero-lead">{t.heroLine}</p>
        <p class="hero-intro">{t.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={draft.dm}>{t.order}<Icon /></a>
          <a class="button secondary" href="#collection">{t.browse}<span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="editorial-frame hero-image">
        <picture>
          <source type="image/avif" srcset={responsiveSources(images.hero, 'avif')} sizes="(min-width: 900px) 46vw, 100vw" />
          <source type="image/webp" srcset={responsiveSources(images.hero, 'webp')} sizes="(min-width: 900px) 46vw, 100vw" />
          <img src={imagePath(images.hero)} alt={images.hero.alt[locale]} width="1200" height="1200" loading="eager" fetchpriority="high" decoding="sync" />
        </picture>
        <figcaption>{t.illustrationDisclaimer}</figcaption>
      </figure>
    </section>

    <section id="collection" class="section collection-section wrap" aria-labelledby="collection-title">
      <div class="section-intro">
        <p class="eyebrow">{t.collectionEyebrow}</p>
        <h2 id="collection-title">{t.collectionTitle}</h2>
        <p>{t.collectionIntro}</p>
      </div>
      <div class="collection-grid">
        {collection.map(item => <a class="collection-card" href={instagram}>
          <span class="editorial-frame collection-image">
            <picture>
              <source type="image/avif" srcset={responsiveSources(item.image, 'avif')} sizes="(min-width: 1000px) 23vw, 48vw" />
              <source type="image/webp" srcset={responsiveSources(item.image, 'webp')} sizes="(min-width: 1000px) 23vw, 48vw" />
              <img src={imagePath(item.image)} alt={item.image.alt[locale]} width="1200" height="1200" loading="lazy" decoding="async" />
            </picture>
          </span>
          <span class="card-copy"><strong>{item.title}</strong><span>{item.descriptor}</span></span>
        </a>)}
      </div>
      <p class="illustration-disclaimer">{t.illustrationDisclaimer}</p>
    </section>

    <section id="sur-mesure" class="custom-section section" aria-labelledby="custom-title">
      <div class="custom-layout wrap">
        <div class="custom-copy">
          <p class="eyebrow">{t.customEyebrow}</p>
          <h2 id="custom-title">{t.customTitle}</h2>
          <p>{t.customDescription}</p>
          <ol class="steps">
            {t.steps.map(step => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
          </ol>
          <a class="button secondary" href={draft.dm}>{t.customCta}<Icon /></a>
        </div>
        <figure class="editorial-frame custom-image">
          <picture>
            <source type="image/avif" srcset={responsiveSources(images.matching, 'avif')} sizes="(min-width: 900px) 42vw, 100vw" />
            <source type="image/webp" srcset={responsiveSources(images.matching, 'webp')} sizes="(min-width: 900px) 42vw, 100vw" />
            <img src={imagePath(images.matching)} alt={images.matching.alt[locale]} width="1200" height="1200" loading="lazy" decoding="async" />
          </picture>
        </figure>
      </div>
    </section>

    <section id="commander" class="contact-section section wrap" aria-labelledby="contact-title">
      <p class="eyebrow">{t.contactEyebrow}</p>
      <h2 id="contact-title">{t.contactTitle}</h2>
      <p>{t.contactText}</p>
      <a class="button primary" href={draft.dm}>{t.contactCta}<Icon /></a>
      <p class="handle" dir="ltr">{draft.handle}</p>
      <p class="contact-address">{business.address}</p>
    </section>
  </main>
  <div class="mobile-cta" hidden>
    <a href={draft.dm}>{t.contactCta}<Icon /></a>
  </div>
  <script>
    const bar = document.querySelector<HTMLElement>('.mobile-cta');
    const contact = document.getElementById('commander');
    if (bar && contact && 'IntersectionObserver' in window) {
      document.body.classList.add('has-mobile-cta');
      const observer = new IntersectionObserver(entries => {
        bar.hidden = entries.some(entry => entry.isIntersecting);
        document.body.classList.toggle('cta-visible', !bar.hidden);
      }, { threshold: 0 });
      observer.observe(contact);
    }
  </script>
</Base>
