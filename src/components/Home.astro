---
import {getCollection} from 'astro:content';
import {Picture,getImage} from 'astro:assets';
import Base from '../layouts/Base.astro';
import JewelDrawing from './JewelDrawing.astro';
import Icon from './Icon.astro';
import Fact from './Fact.astro';
import {dictionary,homePath,type Locale} from '../i18n';
import {business,draft,confirmed} from '../data/business';
interface Props {locale:Locale;}
const {locale}=Astro.props;const t=dictionary(locale);
const entries=(await getCollection('products')).sort((a,b)=>a.data.order-b.data.order);
const hero=entries.find(e=>e.data.hero)?.data;const facts=business.facts;
const answers=[facts.order[locale],facts.custom[locale],facts.delivery[locale],facts.returns[locale],facts.hallmark[locale]];
const faqHrefs=[draft.dm,draft.dm,draft.dm,'/retours-et-remboursement/',draft.dm];
const clean=(v:string)=>v.replace('[CONFIRMER]','').trim();
const schema:unknown[]=[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:t.faqQuestions.map((name,i)=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text:clean(answers[i])+(answers[i].includes('[CONFIRMER]')?' [CONFIRMER]':'')}}))}];
if(confirmed(business.tradeName)) schema.push({'@context':'https://schema.org','@type':confirmed(business.address)&&business.address!=='online only'&&confirmed(business.openingHours)?'JewelryStore':'Organization',name:business.tradeName,legalName:business.legalName,url:new URL(homePath(locale),Astro.site).href,sameAs:[draft.instagram],...(confirmed(business.address)&&business.address!=='online only'?{address:business.address}:{}),...(confirmed(business.openingHours)?{openingHours:business.openingHours}:{}),...(confirmed(business.deliveryAreas)?{areaServed:business.deliveryAreas}:{})});
const heroPreloads=hero?.image?await Promise.all([480,800,1200].map(width=>getImage({src:hero.image!,width,format:'avif',quality:75}))):[];
---
<Base locale={locale} title={t.title} description={t.description} home schema={schema}>
{heroPreloads.length>0&&<link slot="head" rel="preload" as="image" href={heroPreloads[0].src} imagesrcset={heroPreloads.map((image,i)=>`${image.src} ${[480,800,1200][i]}w`).join(", ")} imagesizes="(min-width: 900px) 48vw, 100vw" type="image/avif" fetchpriority="high"/>}
<main id="main" tabindex="-1">
<section class="hero wrap" aria-labelledby="hero-title">
<div class="hero-copy"><p class="eyebrow">{t.eyebrow}<span class="tiny-rule"></span></p><h1 id="hero-title">{t.heroLines.map(line=><span>{line}</span>)}</h1><p class="hero-intro">{t.intro}</p><p class="hero-custom"><Fact text={facts.custom[locale]}/></p><div class="hero-actions"><a class="button primary" href={draft.dm}>{t.order}<Icon/></a><a class="button secondary" href="#collection">{t.browse}<span aria-hidden="true">&#8595;</span></a></div><p class="material-note">{confirmed(business.material)?t.materialVerified:<>{t.materialPending} <span lang="fr" dir="ltr">{t.confirm}</span></>}</p></div>
<figure class="hero-art">{hero?.image?<Picture src={hero.image} alt={hero.alt[locale]} formats={['avif','webp']} widths={[480,800,1200]} sizes="(min-width: 900px) 48vw, 100vw" loading="eager" fetchpriority="high" decoding="sync" quality={75}/>:<><div class="art-corner top"><span>{t.illustration}</span><span aria-hidden="true">01</span></div><JewelDrawing hero/><span class="art-monogram" aria-hidden="true" dir="ltr">HB</span><figcaption class="art-corner bottom"><span>{t.heroCaption}</span><span class="photo-pending">{t.photoPending}</span></figcaption></>}</figure></section>
<section id="collection" class="section collection-section wrap" aria-labelledby="collection-title"><div class="section-heading"><p class="eyebrow">{t.collectionEyebrow}</p><h2 id="collection-title" class="line-title">{t.collectionTitle}</h2><p>{t.collectionIntro}</p></div><div class="collection-grid">{entries.map(({data:p})=><article class:list={['product',p.category]}><a class="product-art" href={p.image?p.image.src:draft.instagram} ><span class="sr-only">{p.image?t.imageView:t.collectionLink} : {p.title[locale]}. </span>{p.image?<Picture src={p.image} alt={p.alt[locale]} formats={['avif','webp']} widths={[360,640,960]} sizes="(min-width: 900px) 55vw, 100vw" loading="lazy" decoding="async" quality={75}/>:<><span class="product-number">{String(p.order).padStart(2,'0')}</span>{' '}<JewelDrawing kind={p.category}/><span class="illustration-label">{t.illustration}</span></>}<span class="product-arrow"><Icon/></span></a><div class="product-caption"><h3><a href={draft.instagram}>{p.title[locale]}</a></h3><p>{p.subtitle[locale]}</p></div>{p.image&&<p class="image-credit">{t.rights} : {p.credit}</p>}</article>)}</div><a class="text-link collection-all" href={draft.instagram}>{t.allLink}<Icon/></a></section>
<section id="sur-mesure" class="custom-section section"><div class="wrap"><div class="custom-intro"><div><p class="eyebrow">{t.customEyebrow}</p><h2 class="line-title">{t.customTitle}</h2></div><div class="custom-summary"><h3>{t.customIntro}</h3><p>{t.customPrompt}</p><p><Fact text={facts.process[locale]}/></p></div></div><ol class="steps">{t.steps.map((step,i)=><li><span class="step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><h3>{step.title}</h3><p>{step.text}</p><a class="text-link" href={i===0?draft.instagram:draft.dm}>{step.link}<Icon/></a></li>)}</ol></div></section>
<section class="gold-section section wrap" id="notre-or" aria-labelledby="gold-title"><p class="eyebrow">{t.goldEyebrow}</p><h2 id="gold-title" class="line-title">{t.goldTitle}</h2><div><p><Fact text={facts.gold[locale]}/></p><p class="subtle"><Fact text={facts.hallmark[locale]}/></p><a class="text-link" href={draft.dm}>{t.goldLink}<Icon/></a></div></section>
<section id="questions" class="faq-section section wrap"><div><p class="eyebrow">{t.faqEyebrow}</p><h2 class="line-title">{t.faqTitle}</h2></div><div class="faq-list">{t.faqQuestions.map((question,i)=><details class="faq"><summary><span>{question}</span><Icon kind="plus"/></summary><div class="faq-answer"><p><Fact text={answers[i]}/></p><a class="text-link" href={faqHrefs[i]}>{t.faqLinks[i]}<Icon/></a></div></details>)}</div></section>
<section id="commander" class="contact-section section"><div class="wrap contact-inner"><p class="eyebrow">{t.contactEyebrow}</p><h2 class="line-title">{t.contactTitle}</h2><p><Fact text={facts.order[locale]}/></p><a class="button primary" href={draft.dm}>{t.write}<Icon/></a><p class="contact-note">{t.contactNote}</p>{confirmed(business.responseTime)&&<p>{business.responseTime}</p>}<div class="optional-contacts">{confirmed(business.phone)&&<a href={'tel:'+business.phone}>{t.phone}</a>}{confirmed(business.whatsapp)&&<a href={'https://wa.me/'+business.whatsapp.replace(/\D/g,'')}>{t.whatsapp}</a>}{confirmed(business.address)&&business.address!=='online only'&&<a href={'https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(business.address)}>{t.directions}</a>}</div><a class="handle" href={draft.instagram} dir="ltr">{draft.handle}</a></div></section>
</main><div class="mobile-cta" hidden><a href={draft.dm}>{t.order}<Icon/></a></div>
<script>
const bar=document.querySelector<HTMLElement>('.mobile-cta');const contact=document.getElementById('commander');
if(bar&&contact&&'IntersectionObserver' in window){document.body.classList.add('has-mobile-cta');const observer=new IntersectionObserver(entries=>{const inView=entries.some(e=>e.isIntersecting);bar.hidden=inView;document.body.classList.toggle('cta-visible',!inView);},{threshold:0});observer.observe(contact);document.addEventListener('focusin',event=>{if(event.target instanceof HTMLElement&&window.matchMedia('(max-width: 899px)').matches){const rect=event.target.getBoundingClientRect();if(!bar.hidden&&rect.bottom>window.innerHeight-bar.offsetHeight)event.target.scrollIntoView({block:'center'});}});}
document.querySelectorAll('.mobile-menu a').forEach(link=>link.addEventListener('click',()=>document.querySelector('.mobile-menu')?.removeAttribute('open')));
document.addEventListener('keydown',event=>{if(event.key==='Escape'){const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu[open]');if(menu){menu.open=false;menu.querySelector('summary')?.focus();}}});
</script>
</Base>
