---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Picture from './Picture.astro';
import { dictionary, homePath, type Locale } from '../i18n';
import { business, draft } from '../data/business';
import { images, pairs } from '../data/images';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dictionary(locale);
const f = business.facts;
const instagram = draft.instagram;
const collection = [images.bracelets, images.personalized, images.earrings, images.necklaces]
  .map((image, i) => ({ image, ...t.collectionItems[i] }));
// The practical facts closing the page: all from confirmed owner statements in business.ts.
const verso = [
  [t.versoLabels[0], f.order[locale]],
  [t.versoLabels[1], f.delivery[locale]],
  [t.versoLabels[2], `${f.gold[locale]} ${f.hallmark[locale]}`],
  [t.versoLabels[3], f.returns[locale]],
  [t.versoLabels[4], t.address],
];
const plateSizes = '(min-width: 900px) 440px, (min-width: 520px) 440px, calc(100vw - 56px)';
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Haddar Bijoux',
  url: new URL(homePath(locale), Astro.site).href,
  sameAs: [instagram],
}];
---
<Base locale={locale} title={t.title} description={t.description} home schema={schema}>
  <main id="main" tabindex="-1">
    <section class="hero wrap" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero-name"><span lang="fr" dir="ltr">Haddar</span> <span lang="fr" dir="ltr">Bijoux</span></h1>
      <figure class="hero-piece">
        <div class="liner"><Picture image={images.trio} locale={locale} sizes="(min-width: 1100px) 520px, (min-width: 600px) 500px, calc(100vw - 56px)" eager /></div>
        <figcaption>{images.trio.caption[locale]}</figcaption>
      </figure>
      <div class="hero-intro">
        <p class="hero-line">{t.heroLine.map((line, i) => <>{i > 0 && ' '}<span>{line}</span></>)}</p>
        <div class="hero-actions">
          <a class="button primary" href={draft.dm}>{t.order}<Icon /></a>
          <a class="text-link" href="#pieces">{t.browse}<Icon kind="down" /></a>
        </div>
      </div>
      <ul class="hero-facts">
        <li>{f.hallmark[locale]}</li>
        <li>{f.order[locale]}</li>
      </ul>
    </section>

    <section id="pieces" class="section pieces" aria-labelledby="pieces-title">
      <header class="section-intro wrap">
        <h2 id="pieces-title">{t.galleryTitle}</h2>
        <p>{t.galleryIntro}</p>
      </header>
      {pairs.map((pair, i) => <div class:list={['pair wrap', { 'pair-worn': i === 2 }]}>
        {i === 2 && <h3 class="pair-title">{t.wornTitle}</h3>}
        {pair.map(image => <figure class="plate" id={image.id}>
          <div class="liner"><Picture image={image} locale={locale} sizes={plateSizes} /></div>
          <figcaption><span class="plate-name">{image.caption[locale]}</span><span class="plate-detail">{image.detail[locale]}</span></figcaption>
        </figure>)}
      </div>)}
      <p class="section-link wrap"><a class="text-link" href={instagram}>{t.galleryLink}<Icon /></a></p>
    </section>

    <div class="cloth">
      <section id="collection" class="section collection" aria-labelledby="collection-title">
        <header class="section-intro wrap">
          <h2 id="collection-title">{t.collectionTitle}</h2>
          <p>{t.collectionIntro}</p>
        </header>
        <div class="collection-grid wrap">
          {collection.map(item => <a class="collection-card" href={instagram}>
            <span class="frame"><Picture image={item.image} locale={locale} sizes="(min-width: 1000px) 22vw, (min-width: 600px) 44vw, calc(50vw - 28px)" /></span>
            <span class="card-copy"><strong>{item.title}</strong>{item.descriptor && <span>{item.descriptor}</span>}<span class="card-label">{t.illustrationLabel}</span></span>
          </a>)}
        </div>
      </section>

      <section id="sur-mesure" class="section custom" aria-labelledby="custom-title">
        <div class="custom-layout wrap">
          <figure class="custom-media">
            <div class="frame"><Picture image={images.matching} locale={locale} sizes="(min-width: 900px) 40vw, calc(100vw - 40px)" /></div>
            <figcaption>{t.illustrationLabel}</figcaption>
          </figure>
          <div class="custom-copy">
            <h2 id="custom-title">{t.customTitle}</h2>
            <p>{t.customDescription}</p>
            <ol class="steps">
              {t.steps.map(step => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
            </ol>
            <a class="button secondary" href={draft.dm}>{t.customCta}<Icon /></a>
          </div>
        </div>
      </section>
    </div>

    <section id="commander" class="section order wrap" aria-labelledby="contact-title">
      <h2 id="contact-title">{t.contactTitle}</h2>
      <p class="order-text">{t.contactText}</p>
      <a class="button primary" href={draft.dm}>{t.contactCta}<Icon /></a>
      <a class="handle" href={instagram} dir="ltr">{draft.handle}</a>
      <h3 class="sr-only">{t.versoTitle}</h3>
      <dl class="verso">
        {verso.map(([label, value], i) => <div><dt>{label}</dt><dd>{value}{i === 3 && <a class="text-link" href="/retours-et-remboursement/" hreflang="fr">{t.returnsLink}</a>}</dd></div>)}
      </dl>
    </section>
  </main>
  <div class="mobile-cta" hidden>
    <a href={draft.dm}>{t.contactCta}<Icon /></a>
  </div>
  <script>
    // Mobile order bar: only once the hero buttons have scrolled away, and never over the Commander section.
    const bar = document.querySelector<HTMLElement>('.mobile-cta');
    const hero = document.querySelector('.hero-actions');
    const contact = document.getElementById('commander');
    if (bar && hero && contact && 'IntersectionObserver' in window) {
      document.body.classList.add('has-mobile-cta');
      const seen = new Map<Element, boolean>([[hero, true], [contact, false]]);
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) seen.set(entry.target, entry.isIntersecting);
        bar.hidden = seen.get(hero)! || seen.get(contact)!;
      });
      observer.observe(hero);
      observer.observe(contact);
    }
  </script>
</Base>
