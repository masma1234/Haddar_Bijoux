---
interface Props { kind?: string; hero?: boolean; }
const {kind='classic',hero=false}=Astro.props;
const links=Array.from({length:18},(_,i)=>{const a=i*Math.PI*2/18;return {x:200+Math.cos(a)*125,y:200+Math.sin(a)*87,r:i*20+90};});
---
<svg viewBox="0 0 400 400" fill="none" aria-hidden="true" class:list={['jewel-drawing',{'hero-drawing':hero}]} stroke="currentColor" stroke-width={hero ? '1.3':'1.8'}>
{(kind==='classic'||kind==='all') && <g transform="rotate(-32 200 200)">{links.map(l=><ellipse cx={l.x} cy={l.y} rx="21" ry="10" transform={`rotate(${l.r} ${l.x} ${l.y})`}/>)}<path d="M320 178l13 13-12 13"/></g>}
{kind==='personalized' && <g transform="rotate(-26 200 200)"><path d="M139 132C28 146 40 282 174 284c145 0 181-132 79-151M134 145C46 162 63 270 178 270c125 0 159-108 76-123"/><rect x="137" y="109" width="123" height="50" rx="2"/><path d="M155 119h87M155 149h87M128 127h10M259 127h11"/></g>}
{kind==='matching' && <g transform="rotate(-28 200 200)"><ellipse cx="162" cy="179" rx="94" ry="64"/><ellipse cx="162" cy="179" rx="86" ry="57"/><path d="M135 246c10 71 177 70 179-5 1-47-54-69-93-64M148 246c13 58 154 59 155-5 0-39-47-59-79-53"/></g>}
{kind==='earrings' && <g transform="rotate(-12 200 200)"><ellipse cx="133" cy="200" rx="48" ry="86"/><ellipse cx="133" cy="200" rx="40" ry="78"/><ellipse cx="267" cy="200" rx="48" ry="86"/><ellipse cx="267" cy="200" rx="40" ry="78"/><path d="M124 113v-12h17v12M258 113v-12h17v12"/></g>}
{kind==='necklaces' && <g><path d="M126 55c0 82-81 144-58 198 18 45 83 79 132 85 49-6 114-40 132-85 23-54-58-116-58-198M135 55c0 87-79 149-58 197 18 40 77 71 123 77 46-6 105-37 123-77 21-48-58-110-58-197"/><circle cx="200" cy="342" r="22"/><circle cx="200" cy="342" r="16"/></g>}
</svg>
