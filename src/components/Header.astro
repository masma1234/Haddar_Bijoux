---
import { dictionary, homePath, type Locale } from '../i18n';
import { draft } from '../data/business';
import Icon from './Icon.astro';
interface Props {locale:Locale; alternate:string;}
const {locale,alternate}=Astro.props;const t=dictionary(locale);const ids=['pieces','sur-mesure','commander'];
const links=t.nav.map((label,i)=>({label,href:homePath(locale)+'#'+ids[i]}));
---
<a class="skip-link" href="#main">{t.skip}</a>
<header class="site-header">
  <div class="header-bar wrap">
    <a class="wordmark" href={homePath(locale)} lang="fr" dir="ltr">{t.brand}</a>
    <nav class="site-nav" aria-label={t.navLabel}>{links.map(l=><a href={l.href}>{l.label}</a>)}</nav>
    <div class="header-actions">
      <a class="language-link" href={alternate} lang={locale==='fr'?'ar':'fr'} dir={locale==='fr'?'rtl':'ltr'} title={t.languageLabel}>{t.language}</a>
      <a class="instagram-link" href={draft.instagram} aria-label={t.instagramLabel}><Icon kind="instagram"/></a>
    </div>
  </div>
</header>
