---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {dictionary,type Locale} from '../i18n';
import fonts from '../data/font-manifest.json';
import '../styles/global.css';
interface Props {locale:Locale;title:string;description:string;alternate?:string;noindex?:boolean;schema?:unknown[];home?:boolean;}
const {locale,title,description,alternate=locale==='fr'?'/ar/':'/',noindex=false,schema=[],home=false}=Astro.props;
const t=dictionary(locale);const canonical=new URL(Astro.url.pathname,Astro.site);const font=fonts[locale];const isLegal=!home&&!noindex;
---
<!doctype html><html lang={locale} dir={t.dir}><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/><meta name="theme-color" content="#FFFFFF"/>
<title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="fr" href={new URL(locale==='fr'?Astro.url.pathname:alternate,Astro.site)}/>{!isLegal&&<link rel="alternate" hreflang="ar" href={new URL(locale==='ar'?Astro.url.pathname:alternate,Astro.site)}/>}<link rel="alternate" hreflang="x-default" href={new URL(locale==='fr'?Astro.url.pathname:alternate,Astro.site)}/>{noindex&&<meta name="robots" content="noindex, follow"/>}
<meta property="og:type" content="website"/><meta property="og:site_name" content={t.brand}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={locale==='ar'?'ar_TN':'fr_TN'}/><meta property="og:image" content={new URL('/share-'+locale+'.jpg',Astro.site)}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={t.brand}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL('/share-'+locale+'.jpg',Astro.site)}/><meta name="twitter:image:alt" content={t.brand}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>{font.preload.map(href=><link rel="preload" href={href} as="font" type="font/woff2" crossorigin/>)}<link rel="stylesheet" href={font.css}/>{schema.map(item=><script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g,'\\u003c')}/>)}<slot name="head"/>
</head><body class:list={[locale,{'home-page':home}]}><Header locale={locale} alternate={alternate}/><slot/><Footer locale={locale}/></body></html>
